rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "admin@gmail.com";
    }

    function isAdminOrderStatusUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(["status", "updatedAt"])
        && resource.data.status in ["paid", "preparing", "shipping", "delivered", "cancelled"]
        && request.resource.data.status in ["preparing", "shipping", "delivered", "cancelled"];
    }

    match /users/{userId} {
      allow create, update: if signedIn()
        && request.auth.uid == userId;

      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow delete: if false;
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending";

      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow update: if isAdmin()
        && isAdminOrderStatusUpdate();
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
