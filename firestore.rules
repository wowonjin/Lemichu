rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "admin@gmail.com";
    }

    function isAdminOrderStatusUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(["status", "updatedAt"])
        && resource.data.status in ["paid", "preparing", "shipping", "delivered", "cancelled"]
        && request.resource.data.status in ["preparing", "shipping", "delivered", "cancelled"];
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && (!("points" in request.resource.data) || request.resource.data.points == 0);

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.get("points", resource.data.get("points", 0))
          == resource.data.get("points", 0);

      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow delete: if false;
    }

    match /users/{userId}/pointLedger/{entryId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow write: if false;
    }

    match /users/{userId}/wishlist/{productId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.productId == productId;

      allow delete: if signedIn()
        && request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending";

      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow update: if isAdmin()
        && isAdminOrderStatusUpdate();
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /products_import_staging/{productId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /buyma_translated_source/{productId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /siteSettings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /heroSlides/{slideId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /homeCategories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /homeSectionSlots/{slotId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /productSignals/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /searchEvents/{eventId} {
      allow read, write: if false;
    }

    match /bankRelayDevices/{deviceId} {
      allow read, write: if false;
    }

    match /bankDepositEvents/{eventHash} {
      allow read, write: if false;
    }

    match /bankRelayNonces/{nonceHash} {
      allow read, write: if false;
    }

    match /bankRelayAuditLogs/{logId} {
      allow read, write: if false;
    }

    match /searchCounters/{counterId} {
      allow read: if true;
      allow write: if false;
    }

    match /searchStats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    match /coupons/{couponId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /userCoupons/{couponId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if false;
    }

    match /sellRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /returnRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /memberNotifications/{notificationId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
  }
}
