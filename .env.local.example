NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# 로컬: http://localhost:3000 / 운영: https://lemichu.shop
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# 카카오톡 채널 1:1 채팅 URL. 상품 문의 시 운영 상품 페이지가 함께 복사됩니다.
NEXT_PUBLIC_KAKAO_CHAT_URL=https://pf.kakao.com/_xfmkgn

# Firebase Admin SDK — 서버 전용. 결제 승인 API에서 Auth 토큰 검증과 주문 상태 갱신에 사용합니다.
# 아래 JSON 값은 서비스 계정 JSON 전체를 한 줄 문자열 또는 base64로 넣을 수 있습니다.
FIREBASE_SERVICE_ACCOUNT_JSON=
# 또는 GOOGLE_APPLICATION_CREDENTIALS에 서비스 계정 JSON 파일 경로를 지정할 수 있습니다.
GOOGLE_APPLICATION_CREDENTIALS=
# JSON 환경변수 대신 개별 값으로 설정할 때 사용합니다.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

LEMICHU_ADMIN_EMAIL=
LEMICHU_ADMIN_PASSWORD=

# 토스페이먼츠 단건 결제 — 서버 전용. 클라이언트 키도 API 응답으로만 내려보냅니다.
TOSS_PAYMENT_CLIENT_KEY=
TOSS_SECRET_KEY=

# KB 무통장입금 Android 릴레이 — 모두 서버 전용, NEXT_PUBLIC_ 사용 금지.
# 실제 서버폰 번호와 Secret은 배포 환경/.env.local에만 입력하고 Git에 기록하지 마세요.
KB_RELAY_DEVICE_ID=kb-server-phone-01
KB_RELAY_DEVICE_NAME=KB 입금 서버폰
KB_RELAY_DEVICE_PHONE=
KB_RELAY_DEVICE_SECRET=
# KB 입금문자에 표시되는 마스킹 계좌(예: 숫자와 * 조합)
KB_RELAY_ACCOUNT_MASK=
BANK_TRANSFER_DEPOSIT_DUE_HOURS=24

# 네이버 로그인 (회원 OAuth) — 서버 전용. 커머스 API와 별도 애플리케이션입니다.
# 네이버 개발자센터 > 내 애플리케이션 > 네이버 로그인에서 Client ID/Secret을 발급하세요.
# Callback URL 예:
#   http://localhost:3000/api/auth/naver/callback
#   https://lemichu.shop/api/auth/naver/callback
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=

# 네이버 커머스 API (스마트스토어) — 서버 전용. 절대 NEXT_PUBLIC_ 접두사 사용 금지.
# 애플리케이션 ID / 시크릿은 커머스 API 센터 > 내 애플리케이션에서 발급합니다.
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=
# 판매자 ID (예: ncp_1owsby_01). AUTH_TYPE=SELLER 일 때 필요합니다.
NAVER_COMMERCE_ACCOUNT_ID=ncp_1owsby_01
# SELF(내스토어 애플리케이션, 기본) 또는 SELLER(솔루션이 판매자 스토어를 관리)
NAVER_COMMERCE_AUTH_TYPE=SELF
